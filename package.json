{
  "name": "illusion-of-dawn",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && NODE_ENV=development electron electron/main.js\"",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "phaser": "^3.88.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.frontup.illusion-of-dawn",
    "productName": "Illusion of Dawn",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
